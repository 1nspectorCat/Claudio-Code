        android:fillColor="#D97757"
        android:pathData="M54,22
            C54,44.4 63.6,54 86,54
            C63.6,54 54,63.6 54,86
            C54,63.6 44.4,54 22,54
            C44.4,54 54,44.4 54,22 Z" />

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="45"
        android:scaleX="0.58"
        android:scaleY="0.58">
        <path
            android:fillColor="#D97757"
            android:pathData="M54,22
